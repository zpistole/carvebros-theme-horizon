{% liquid
  assign shop_url = section.settings.link
  if shop_url == blank
    assign shop_url = pages.about.url
  endif
  if shop_url == blank
    assign shop_url = '/pages/about'
  endif
%}

<div class="local-shop__inner">
  <div class="local-shop__intro">
    <p class="local-shop__eyebrow">{{ section.settings.eyebrow | escape }}</p>
    <h1 class="local-shop__heading">{{ section.settings.heading | escape }}</h1>
    <p class="local-shop__text">{{ section.settings.text | escape }}</p>
    {% if shop.address.city != blank or shop.phone != blank %}
      {% liquid
        assign phone_digits = shop.phone | remove: ' ' | remove: '-' | remove: '(' | remove: ')' | remove: '.' | remove: '+'
        assign phone_label = shop.phone
        if phone_digits.size == 11 and phone_digits.first == '1'
          assign phone_digits = phone_digits | remove_first: '1'
        endif
        if phone_digits.size == 10
          assign phone_area = phone_digits | slice: 0, 3
          assign phone_mid = phone_digits | slice: 3, 3
          assign phone_last = phone_digits | slice: 6, 4
          assign phone_label = '(' | append: phone_area | append: ') ' | append: phone_mid | append: '-' | append: phone_last
        endif
      %}
      <p class="local-shop__place">
        {%- if shop.address.address1 != blank -%}{{ shop.address.address1 | escape }}, {% endif -%}
        {%- if shop.address.city != blank -%}{{ shop.address.city | escape }}{% endif -%}
        {%- if shop.address.province != blank -%}, {{ shop.address.province | escape }}{% endif -%}
        {%- if shop.phone != blank -%}
          <a href="tel:+1{{ phone_digits }}">{{ phone_label | escape }}</a>
        {%- endif -%}
      </p>
    {% endif %}
    <a class="local-shop__link" href="{{ shop_url }}">{{ section.settings.button_label | escape }}</a>
  </div>
  <ul class="local-shop__points">
    <li>
      <h3>{{ section.settings.point_1_title | escape }}</h3>
      <p>{{ section.settings.point_1_text | escape }}</p>
    </li>
    <li>
      <h3>{{ section.settings.point_2_title | escape }}</h3>
      <p>{{ section.settings.point_2_text | escape }}</p>
    </li>
    <li>
      <h3>{{ section.settings.point_3_title | escape }}</h3>
      <p>{{ section.settings.point_3_text | escape }}</p>
    </li>
  </ul>
</div>

<script type="application/ld+json">
  {
    "@context": "https://schema.org",
    "@type": "LocalBusiness",
    "@id": {{ shop.url | append: '#business' | json }},
    "name": {{ shop.name | json }},
    "url": {{ shop.url | json }},
    "description": {{ section.settings.text | json }},
    "areaServed": {
      "@type": "AdministrativeArea",
      "name": {{ section.settings.eyebrow | json }}
    }
    {%- if settings.logo != blank -%}
      ,"image": {{ settings.logo | image_url: width: 1200 | prepend: 'https:' | json }}
    {%- endif -%}
    {%- if shop.phone != blank -%}
      ,"telephone": {{ shop.phone | json }}
    {%- endif -%}
    {%- if shop.address.address1 != blank or shop.address.city != blank -%}
      ,"address": {
        "@type": "PostalAddress"
        {%- if shop.address.address1 != blank -%}
          ,"streetAddress": {{ shop.address.address1 | json }}
        {%- endif -%}
        {%- if shop.address.city != blank -%}
          ,"addressLocality": {{ shop.address.city | json }}
        {%- endif -%}
        {%- if shop.address.province != blank -%}
          ,"addressRegion": {{ shop.address.province | json }}
        {%- endif -%}
        {%- if shop.address.zip != blank -%}
          ,"postalCode": {{ shop.address.zip | json }}
        {%- endif -%}
        {%- if shop.address.country != blank -%}
          ,"addressCountry": {{ shop.address.country | json }}
        {%- endif -%}
      }
    {%- endif -%}
  }
</script>

{% stylesheet %}
  .local-shop {
    background: #f7f4ef;
    color: #242521;
  }

  .local-shop__inner {
    display: grid;
    grid-template-columns: minmax(0, 0.9fr) minmax(0, 1.1fr);
    gap: 48px 8%;
    align-items: start;
    padding: 72px 7%;
  }

  .local-shop__eyebrow {
    margin: 0 0 14px;
    color: #8a4b2f;
    font-size: 12px;
    font-weight: 700;
    letter-spacing: 0.16em;
    text-transform: uppercase;
  }

  .local-shop__heading {
    margin: 0;
    font-family: var(--font-heading--family);
    font-size: clamp(32px, 4vw, 52px);
    font-weight: 400;
    letter-spacing: -0.03em;
    line-height: 1.05;
  }

  .local-shop__text {
    max-width: 38rem;
    margin: 18px 0 0;
    color: #4d4c47;
    font-size: 17px;
    line-height: 1.65;
  }

  .local-shop__place {
    margin: 16px 0 0;
    color: #242521;
    font-size: 15px;
    font-weight: 600;
    line-height: 1.5;
  }

  .local-shop__place a {
    display: inline-block;
    margin-left: 12px;
    color: inherit;
    font-weight: 600;
    text-underline-offset: 3px;
  }

  .local-shop__place a:hover {
    color: #8a4b2f;
  }

  .local-shop__link {
    display: inline-block;
    margin-top: 22px;
    color: inherit;
    font-size: 15px;
    font-weight: 700;
    text-decoration: underline;
    text-underline-offset: 4px;
  }

  .local-shop__link:hover {
    color: #8a4b2f;
  }

  .local-shop__link:focus-visible {
    outline: 3px solid #8a4b2f;
    outline-offset: 4px;
  }

  .local-shop__points {
    display: grid;
    gap: 22px;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .local-shop__points li {
    padding-top: 18px;
    border-top: 1px solid #d9d3c8;
  }

  .local-shop__points h3 {
    margin: 0 0 6px;
    font-family: var(--font-heading--family);
    font-size: 22px;
    font-weight: 500;
    letter-spacing: -0.02em;
  }

  .local-shop__points p {
    margin: 0;
    color: #4d4c47;
    font-size: 16px;
    line-height: 1.6;
  }

  @media (max-width: 800px) {
    .local-shop__inner {
      grid-template-columns: 1fr;
      gap: 32px;
      padding: 48px 6% 56px;
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Local shop",
  "tag": "section",
  "class": "local-shop",
  "settings": [
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow",
      "default": "Southern Oregon"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Custom wooden signs, made in Southern Oregon."
    },
    {
      "type": "textarea",
      "id": "text",
      "label": "Text",
      "default": "Carve Bros is a local business in Southern Oregon. We make custom wooden signs for homes, cabins, and businesses — lettering and layout chosen for the place the sign will hang."
    },
    {
      "type": "text",
      "id": "button_label",
      "label": "Link label",
      "default": "About the shop"
    },
    {
      "type": "url",
      "id": "link",
      "label": "Link"
    },
    {
      "type": "text",
      "id": "point_1_title",
      "label": "Point 1 title",
      "default": "A local shop"
    },
    {
      "type": "textarea",
      "id": "point_1_text",
      "label": "Point 1 text",
      "default": "Designed and made in Southern Oregon. You’re ordering from the people who carve the sign, not a warehouse on the other side of the country."
    },
    {
      "type": "text",
      "id": "point_2_title",
      "label": "Point 2 title",
      "default": "Made for your words"
    },
    {
      "type": "textarea",
      "id": "point_2_text",
      "label": "Point 2 text",
      "default": "Family names, lake houses, shop fronts, and the line you actually want on the wall. Tell us the wording and we’ll build the sign around it."
    },
    {
      "type": "text",
      "id": "point_3_title",
      "label": "Point 3 title",
      "default": "Real wood"
    },
    {
      "type": "textarea",
      "id": "point_3_text",
      "label": "Point 3 text",
      "default": "Each sign is carved in wood, so the grain and the lettering belong to that piece. No two come out quite the same."
    }
  ],
  "presets": [
    {
      "name": "Local shop",
      "category": "Story"
    }
  ]
}
{% endschema %}
