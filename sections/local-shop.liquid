{% liquid
  assign shop_url = section.settings.link
  if shop_url == blank
    assign shop_url = pages.about.url
  endif
  if shop_url == blank
    assign shop_url = '/pages/about'
  endif
%}

<div class="local-shop__inner">
  <div class="local-shop__intro">
    <p class="local-shop__eyebrow">{{ section.settings.eyebrow | escape }}</p>
    <h1 class="local-shop__heading">{{ section.settings.heading | escape }}</h1>
    <p class="local-shop__text">{{ section.settings.text | escape }}</p>
    {% if shop.address.city != blank or shop.phone != blank %}
      {% liquid
        assign phone_digits = shop.phone | remove: ' ' | remove: '-' | remove: '(' | remove: ')' | remove: '.' | remove: '+'
        assign phone_label = shop.phone
        if phone_digits.size == 11 and phone_digits.first == '1'
          assign phone_digits = phone_digits | remove_first: '1'
        endif
        if phone_digits.size == 10
          assign phone_area = phone_digits | slice: 0, 3
          assign phone_mid = phone_digits | slice: 3, 3
          assign phone_last = phone_digits | slice: 6, 4
          assign phone_label = '(' | append: phone_area | append: ') ' | append: phone_mid | append: '-' | append: phone_last
        endif
      %}
      <p class="local-shop__place">
        {%- if shop.address.address1 != blank -%}{{ shop.address.address1 | escape }}, {% endif -%}
        {%- if shop.address.city != blank -%}{{ shop.address.city | escape }}{% endif -%}
        {%- if shop.address.province != blank -%}, {{ shop.address.province | escape }}{% endif -%}
        {%- if shop.phone != blank -%}
          <a href="tel:+1{{ phone_digits }}">{{ phone_label | escape }}</a>
        {%- endif -%}
      </p>
    {% endif %}
    <a class="local-shop__link" href="{{ shop_url }}">{{ section.settings.button_label | escape }}</a>
  </div>
  <ul class="local-shop__points">
    <li>
      <h3>{{ section.settings.point_1_title | escape }}</h3>
      <p>{{ section.settings.point_1_text | escape }}</p>
    </li>
    <li>
      <h3>{{ section.settings.point_2_title | escape }}</h3>
      <p>{{ section.settings.point_2_text | escape }}</p>
    </li>
    <li>
      <h3>{{ section.settings.point_3_title | escape }}</h3>
      <p>{{ section.settings.point_3_text | escape }}</p>
    </li>
  </ul>
</div>

<script type="application/ld+json">
  {
    "@context": "https://schema.org",
    "@type": "LocalBusiness",
    "@id": {{ shop.url | append: '#business' | json }},
    "name": {{ shop.name | json }},
    "url": {{ shop.url | json }},
    "description": {{ section.settings.text | json }},
    "priceRange": "$75+",
    "areaServed": [
      { "@type": "City", "name": "Medford", "containedInPlace": { "@type": "State", "name": "Oregon" } },
      { "@type": "City", "name": "Central Point", "containedInPlace": { "@type": "State", "name": "Oregon" } },
      { "@type": "City", "name": "Jacksonville", "containedInPlace": { "@type": "State", "name": "Oregon" } },
      { "@type": "City", "name": "Ashland", "containedInPlace": { "@type": "State", "name": "Oregon" } },
      { "@type": "City", "name": "Grants Pass", "containedInPlace": { "@type": "State", "name": "Oregon" } }
    ],
    "geo": {
      "@type": "GeoCoordinates",
      "latitude": 42.3553207,
      "longitude": -122.8571786
    }
    {%- liquid
      assign business_image = 'carve-bros-owners.png' | file_url
      if business_image == blank and settings.logo != blank
        assign business_image = settings.logo | image_url: width: 1200
      endif
      unless business_image == blank or business_image contains '://'
        if business_image contains '//'
          assign business_image = business_image | prepend: 'https:'
        else
          assign business_image = business_image | prepend: shop.url
        endif
      endunless
    -%}
    {%- if business_image != blank -%}
      ,"image": {{ business_image | json }}
    {%- endif -%}
    {%- if settings.logo != blank -%}
      ,"logo": {{ settings.logo | image_url: width: 500 | prepend: 'https:' | json }}
    {%- endif -%}
    {%- if shop.phone != blank -%}
      ,"telephone": {{ shop.phone | json }}
    {%- endif -%}
    ,"address": {
      "@type": "PostalAddress"
      {%- if shop.address.address1 != blank -%}
        ,"streetAddress": {{ shop.address.address1 | json }}
      {%- endif -%}
      {%- if shop.address.city != blank -%}
        ,"addressLocality": {{ shop.address.city | json }}
      {%- else -%}
        ,"addressLocality": "Medford"
      {%- endif -%}
      {%- if shop.address.province != blank -%}
        ,"addressRegion": {{ shop.address.province | json }}
      {%- else -%}
        ,"addressRegion": "Oregon"
      {%- endif -%}
      {%- if shop.address.zip != blank -%}
        ,"postalCode": {{ shop.address.zip | json }}
      {%- endif -%}
      {%- if shop.address.country != blank -%}
        ,"addressCountry": {{ shop.address.country | json }}
      {%- else -%}
        ,"addressCountry": "US"
      {%- endif -%}
    }
  }
</script>

<script type="application/ld+json">
  {
    "@context": "https://schema.org",
    "@type": "FAQPage",
    "mainEntity": [
      {
        "@type": "Question",
        "name": {{ section.settings.point_1_title | json }},
        "acceptedAnswer": {
          "@type": "Answer",
          "text": {{ section.settings.point_1_text | json }}
        }
      },
      {
        "@type": "Question",
        "name": {{ section.settings.point_2_title | json }},
        "acceptedAnswer": {
          "@type": "Answer",
          "text": {{ section.settings.point_2_text | json }}
        }
      },
      {
        "@type": "Question",
        "name": {{ section.settings.point_3_title | json }},
        "acceptedAnswer": {
          "@type": "Answer",
          "text": {{ section.settings.point_3_text | json }}
        }
      }
    ]
  }
</script>

{% stylesheet %}
  .local-shop {
    background: #f7f4ef;
    color: #242521;
  }

  .local-shop__inner {
    display: grid;
    grid-template-columns: minmax(0, 0.9fr) minmax(0, 1.1fr);
    gap: 48px 8%;
    align-items: start;
    padding: 72px 7%;
  }

  .local-shop__eyebrow {
    margin: 0 0 14px;
    color: #8a4b2f;
    font-size: 12px;
    font-weight: 700;
    letter-spacing: 0.16em;
    text-transform: uppercase;
  }

  .local-shop__heading {
    margin: 0;
    font-family: var(--font-heading--family);
    font-size: clamp(32px, 4vw, 52px);
    font-weight: 400;
    letter-spacing: -0.03em;
    line-height: 1.05;
  }

  .local-shop__text {
    max-width: 38rem;
    margin: 18px 0 0;
    color: #4d4c47;
    font-size: 17px;
    line-height: 1.65;
  }

  .local-shop__place {
    margin: 16px 0 0;
    color: #242521;
    font-size: 15px;
    font-weight: 600;
    line-height: 1.5;
  }

  .local-shop__place a {
    display: inline-block;
    margin-left: 12px;
    color: inherit;
    font-weight: 600;
    text-underline-offset: 3px;
  }

  .local-shop__place a:hover {
    color: #8a4b2f;
  }

  .local-shop__link {
    display: inline-block;
    margin-top: 22px;
    color: inherit;
    font-size: 15px;
    font-weight: 700;
    text-decoration: underline;
    text-underline-offset: 4px;
  }

  .local-shop__link:hover {
    color: #8a4b2f;
  }

  .local-shop__link:focus-visible {
    outline: 3px solid #8a4b2f;
    outline-offset: 4px;
  }

  .local-shop__points {
    display: grid;
    gap: 22px;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .local-shop__points li {
    padding-top: 18px;
    border-top: 1px solid #d9d3c8;
  }

  .local-shop__points h3 {
    margin: 0 0 6px;
    font-family: var(--font-heading--family);
    font-size: 22px;
    font-weight: 500;
    letter-spacing: -0.02em;
  }

  .local-shop__points p {
    margin: 0;
    color: #4d4c47;
    font-size: 16px;
    line-height: 1.6;
  }

  @media (max-width: 800px) {
    .local-shop__inner {
      grid-template-columns: 1fr;
      gap: 32px;
      padding: 48px 6% 56px;
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Local shop",
  "tag": "section",
  "class": "local-shop",
  "settings": [
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow",
      "default": "Medford, Oregon"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Custom wooden signs, carved in north Medford."
    },
    {
      "type": "textarea",
      "id": "text",
      "label": "Text",
      "default": "Carve Bros cuts each custom wooden sign in a garage workshop in north Medford, Oregon. A sign can hang indoors or outdoors. We make them for Medford, Central Point, Jacksonville, Ashland, and Grants Pass, and we ship finished signs from this shop."
    },
    {
      "type": "text",
      "id": "button_label",
      "label": "Link label",
      "default": "About the shop"
    },
    {
      "type": "url",
      "id": "link",
      "label": "Link"
    },
    {
      "type": "text",
      "id": "point_1_title",
      "label": "Point 1 title",
      "default": "Where are the signs carved?"
    },
    {
      "type": "textarea",
      "id": "point_1_text",
      "label": "Point 1 text",
      "default": "In a garage workshop in north Medford. You are writing to the people who carve the sign. Orders for Medford, Central Point, Jacksonville, Ashland, and Grants Pass are made here."
    },
    {
      "type": "text",
      "id": "point_2_title",
      "label": "Point 2 title",
      "default": "Can a sign hang indoors or outdoors?"
    },
    {
      "type": "textarea",
      "id": "point_2_text",
      "label": "Point 2 text",
      "default": "Both. House numbers, cabin names, and shop signs are carved to be read outside and left in the weather. Name signs and wall pieces are sized for a room. Tell us which one you need."
    },
    {
      "type": "text",
      "id": "point_3_title",
      "label": "Point 3 title",
      "default": "Do you ship, and what does a sign cost?"
    },
    {
      "type": "textarea",
      "id": "point_3_text",
      "label": "Point 3 text",
      "default": "Finished signs ship from Medford. Signs in the shop start at $75. A custom sign is priced from the wording, the size, and where it will hang. We confirm the lettering before we carve."
    }
  ],
  "presets": [
    {
      "name": "Local shop",
      "category": "Story"
    }
  ]
}
{% endschema %}
