    "local_shop": {
      "type": "local-shop",
      "settings": {
        "eyebrow": "Medford, Oregon",
        "heading": "Custom wooden signs, carved in north Medford.",
        "text": "Carve Bros cuts each custom wooden sign in a garage workshop in north Medford, Oregon. A sign can hang indoors or outdoors. We make them for Medford, Central Point, Jacksonville, Ashland, and Grants Pass, and we ship finished signs from this shop.",
        "button_label": "About the shop",
        "link": "shopify://pages/about",
        "point_1_title": "Where are the signs carved?",
        "point_1_text": "In a garage workshop in north Medford. You are writing to the people who carve the sign. Orders for Medford, Central Point, Jacksonville, Ashland, and Grants Pass are made here.",
        "point_2_title": "Can a sign hang indoors or outdoors?",
        "point_2_text": "Both. House numbers, cabin names, and shop signs are carved to be read outside and left in the weather. Name signs and wall pieces are sized for a room. Tell us which one you need.",
        "point_3_title": "Do you ship, and what does a sign cost?",
        "point_3_text": "Finished signs ship from Medford. Signs in the shop start at $75. A custom sign is priced from the wording, the size, and where it will hang. We confirm the lettering before we carve."
      }
    },
    "in_the_shop": {
      "type": "in-the-shop",
      "settings": {
        "image": "shopify://shop_images/Meet_the_Makers__Zach_and_Mark.png",
        "eyebrow": "In the Shop",
        "heading": "Where the signs are made.",
        "note": "lead time is roughly 2.5 weeks.",
        "text": "Send the wording, about how big you want it, and whether it will hang indoors or outdoors. A photo of the wall, porch, or gate helps. We confirm the lettering before we carve, then ship the finished sign from Medford.",
        "button_label": "Reach out about a job",
        "link": "shopify://pages/contact"
      }
    },
