<!doctype html>
<html
  lang="{{ request.locale.iso_code }}"
  dir="{{ request.locale.direction | default: 'ltr' }}"
>
  <head>
    {%- render 'meta-tags' -%}

    {%- if settings.favicon != blank -%}
      <link
        rel="icon"
        type="image/png"
        href="{{ settings.favicon | image_url: width: 32, height: 32 }}"
      >
    {%- endif -%}

    {{ 'soundwood.css' | asset_url | stylesheet_tag }}

    {{ content_for_header }}
  </head>

  <body class="soundwood-page">
    {{ content_for_layout }}
    <script src="{{ 'soundwood.js' | asset_url }}"></script>
  </body>
</html>
