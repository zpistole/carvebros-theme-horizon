{% doc %}
  Renders all meta tags for the page including Open Graph, Twitter Cards, and SEO tags.

  @param {object} [product] - The product object, available on product pages for price meta tags.
{% enddoc %}

<meta charset="utf-8">
<meta
  http-equiv="X-UA-Compatible"
  content="IE=edge"
>
<meta
  name="viewport"
  content="width=device-width,initial-scale=1,viewport-fit=cover"
>
<meta
  name="theme-color"
  content=""
>

{%- liquid
  assign og_title = page_title | default: shop.name
  assign og_url = canonical_url | default: request.origin
  assign og_type = 'website'
  assign og_description = page_description | default: shop.description | default: shop.name
  assign soundwood_page = false

  if request.page_type == 'page' and page.template_suffix == 'soundwood'
    assign soundwood_page = true
    assign soundwood_title = 'Soundwood: Carved Soundwave Keepsake | Carve Bros'
    assign soundwood_description = 'Turn a voice memo, vow, or laugh into carved wood art you can tap to hear. Soundwood by Carve Bros is a custom soundwave keepsake for gifts and remembrance.'

    if page_description == blank
      assign og_description = soundwood_description
    endif

    if page_title == blank or page_title == page.title
      assign og_title = soundwood_title
    endif
  endif

  if request.page_type == 'product'
    assign og_type = 'product'
  elsif request.page_type == 'article'
    assign og_type = 'article'
  elsif request.page_type == 'password'
    assign og_url = request.origin
  endif

  assign soundwood_image = ''
  if soundwood_page
    if page_image != blank
      assign soundwood_image = page_image | image_url | prepend: 'https:'
    else
      assign soundwood_image = 'soundwood.jpg' | asset_url
      unless soundwood_image contains '://'
        if soundwood_image contains '//'
          assign soundwood_image = soundwood_image | prepend: 'https:'
        else
          assign soundwood_image = soundwood_image | prepend: shop.url
        endif
      endunless
    endif
  endif
%}

<meta
  property="og:site_name"
  content="{{ shop.name }}"
>
<meta
  property="og:url"
  content="{{ og_url }}"
>
<meta
  property="og:title"
  content="{{ og_title | escape }}"
>
<meta
  property="og:type"
  content="{{ og_type }}"
>
<meta
  property="og:description"
  content="{{ og_description | escape }}"
>

{%- if soundwood_page -%}
  <link
    rel="preload"
    as="image"
    href="{{ 'soundwood.jpg' | asset_url }}"
    fetchpriority="high"
  >
{%- endif -%}

{%- if page_image -%}
  <meta
    property="og:image"
    content="http:{{ page_image | image_url }}"
  >
  <meta
    property="og:image:secure_url"
    content="https:{{ page_image | image_url }}"
  >
  <meta
    property="og:image:width"
    content="{{ page_image.width }}"
  >
  <meta
    property="og:image:height"
    content="{{ page_image.height }}"
  >
  <meta
    name="twitter:image"
    content="https:{{ page_image | image_url }}"
  >
{%- elsif soundwood_image != blank -%}
  <meta
    property="og:image"
    content="{{ soundwood_image }}"
  >
  <meta
    property="og:image:secure_url"
    content="{{ soundwood_image }}"
  >
  <meta
    property="og:image:width"
    content="1536"
  >
  <meta
    property="og:image:height"
    content="1024"
  >
  <meta
    property="og:image:alt"
    content="Walnut Soundwood plaque with a carved soundwave and the words Love you, Mom"
  >
  <meta
    name="twitter:image"
    content="{{ soundwood_image }}"
  >
  <meta
    name="twitter:image:alt"
    content="Walnut Soundwood plaque with a carved soundwave and the words Love you, Mom"
  >
{%- endif -%}

{%- if request.page_type == 'product' -%}
  <meta
    property="og:price:amount"
    content="{{ product.price | money_without_currency | strip_html }}"
  >
  <meta
    property="og:price:currency"
    content="{{ cart.currency.iso_code }}"
  >
{%- endif -%}

{%- if settings.social_twitter_link != blank -%}
  <meta
    name="twitter:site"
    content="{{ settings.social_twitter_link | split: 'twitter.com/' | last | prepend: '@' }}"
  >
{%- endif -%}
<meta
  name="twitter:card"
  content="summary_large_image"
>
<meta
  name="twitter:title"
  content="{{ og_title | escape }}"
>
<meta
  name="twitter:description"
  content="{{ og_description | escape }}"
>

<title>
  {{ og_title }}
  {%- if current_tags %} &ndash; tagged "{{ current_tags | join: ', ' }}"{% endif -%}
  {%- if current_page != 1 %} &ndash; Page {{ current_page }}{% endif -%}
  {%- unless og_title contains shop.name %} &ndash; {{ shop.name }}{% endunless -%}
</title>

<link
  rel="canonical"
  href="{{ canonical_url }}"
>

{% if page_description or soundwood_page %}
  <meta
    name="description"
    content="{{ og_description | escape }}"
  >
{% endif %}

{%- if soundwood_page -%}
  {% render 'soundwood-structured-data',
    title: og_title,
    description: og_description,
    image_url: soundwood_image,
    page_url: og_url
  %}
{%- endif -%}
